algoritmo "total_3_produtos"

var
   p1, p2, p3, total: real

inicio
   escreva("Digite o valor do primeiro produto: ")
   leia(p1)
   escreva("Digite o valor do segundo produto: ")
   leia(p2)
   escreva("Digite o valor do terceiro produto: ")
   leia(p3)

   total <- p1 + p2 + p3

   escreval("O valor total dos três produtos é: ", total)

fimalgoritmo
